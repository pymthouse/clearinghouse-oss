FROM node:22-bookworm-slim AS deps
WORKDIR /src
ENV CI=true
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
# Mirror sibling-repo layout so control-plane's file:../../builder-sdk resolves to /src/builder-sdk.
COPY builder-sdk /src/builder-sdk
COPY lpclearinghouse/control-plane /src/lpclearinghouse/control-plane
WORKDIR /src/builder-sdk
RUN pnpm install --frozen-lockfile && pnpm build
WORKDIR /src/lpclearinghouse/control-plane
RUN pnpm install

FROM node:22-bookworm-slim
WORKDIR /app/lpclearinghouse/control-plane
ENV CI=true
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
COPY --from=deps /src/builder-sdk /app/builder-sdk
COPY --from=deps /src/lpclearinghouse/control-plane /app/lpclearinghouse/control-plane
WORKDIR /app/lpclearinghouse/control-plane
