{
  "realm": "clearinghouse",
  "enabled": true,
  "sslRequired": "none",
  "displayName": "Livepeer Clearinghouse",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 3600,
  "attributes": {
    "shortVerificationUri": "http://localhost:3001/login/device"
  },
  "authenticationFlows": [
    {
      "alias": "device-third-party-browser",
      "description": "Device browser flow with Dashboard third-party initiate login",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "ch-device-initiate-login",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "livepeer-remote-signer",
      "name": "Livepeer Remote Signer",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "dashboard-signer-bootstrap",
      "name": "Apache DMZ Resource Server (OIDC RP)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dashboard-signer-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/oauth2/callback",
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "+"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "signer-claims"
      ],
      "optionalClientScopes": [
        "sign:job"
      ]
    },
    {
      "clientId": "app_demo",
      "name": "Demo Public Signer App",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://clearinghouse.localhost:8080/*",
        "http://localhost:8080/*",
        "http://localhost:3001/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true",
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "signer-claims"
      ],
      "optionalClientScopes": [
        "sign:job",
        "device:approve"
      ]
    },
    {
      "clientId": "m2m_demo",
      "name": "Demo App M2M (device approval)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "m2m-demo-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "linked.public.client.id": "app_demo"
      },
      "defaultClientScopes": [
        "signer-claims",
        "device:approve",
        "sign:job",
        "users:token",
        "users:write"
      ],
      "optionalClientScopes": []
    }
  ],
  "clientScopes": [
    {
      "name": "users:write",
      "description": "Provision app users for programmatic token mint",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "users:token",
      "description": "Mint user access tokens and approve device codes",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "device:approve",
      "description": "Approve RFC 8628 device codes via token exchange",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "sign:job",
      "description": "Remote signer authorization scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "signer-claims",
      "description": "Claims required by the clearinghouse signer contract",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "client_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "client_id",
            "claim.value": "app_demo",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "usage_subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "usage_subject",
            "claim.name": "usage_subject",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "usage_subject_type",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "usage_subject_type",
            "claim.value": "external_user_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "livepeer-remote-signer-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "livepeer-remote-signer",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "email": "demo-user@example.com",
      "attributes": {
        "usage_subject": [
          "demo-user"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "demo-password",
          "temporary": false
        }
      ]
    }
  ]
}
