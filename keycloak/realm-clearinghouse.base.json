{
  "realm": "clearinghouse",
  "enabled": true,
  "sslRequired": "external",
  "displayName": "Livepeer Clearinghouse",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 3600,
  "clients": [
    {
      "clientId": "livepeer-remote-signer",
      "name": "Livepeer Remote Signer",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "dashboard-signer-bootstrap",
      "name": "Apache DMZ Resource Server (OIDC RP)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${SIGNER_OIDC_CLIENT_SECRET:dashboard-signer-dev-secret}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": ["profile", "email"],
      "optionalClientScopes": []
    }
  ],
  "clientScopes": [
    {
      "name": "sign:job",
      "description": "Remote signer authorization scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "signer-claims",
      "description": "Claims required by the clearinghouse signer contract",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "usage_subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "usage_subject",
            "claim.name": "usage_subject",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "usage_subject_type",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "usage_subject_type",
            "claim.value": "external_user_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "livepeer-remote-signer-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "livepeer-remote-signer",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
