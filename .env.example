# Clearinghouse stack (docker compose from this repo root).
SIGNER_DMZ_HTTP_PORT=8080
SIGNER_PUBLIC_HOSTNAME=localhost
CLEARINGHOUSE_REALM_IMPORT=realm-clearinghouse.json
CLEARINGHOUSE_ADMIN_CLIENT_ID=clearinghouse-admin
# Required (no default). Generate: openssl rand -base64 32
CLEARINGHOUSE_ADMIN_CLIENT_SECRET=
CLEARINGHOUSE_OIDC_ISSUER_URL=https://localhost:8080/realms/clearinghouse
CLEARINGHOUSE_OIDC_INTERNAL_BASE_URL=http://keycloak:8080
CLEARINGHOUSE_OIDC_AUDIENCE=livepeer-remote-signer
CLEARINGHOUSE_ALLOW_INSECURE_OIDC=true
CLEARINGHOUSE_REQUIRE_POSITIVE_BALANCE=false
CLEARINGHOUSE_SEED_DASHBOARD_APP=true
# 32-byte hex key for encrypting per-user Keycloak RO passwords (programmatic token mint).
# Generate: openssl rand -hex 32
CLEARINGHOUSE_CREDENTIAL_ENCRYPTION_KEY=

# Apache DMZ OIDC RP (bearer validation only; signer token exchange uses per-app m2m_*).
SIGNER_OIDC_CLIENT_ID=dashboard-signer-bootstrap
SIGNER_OIDC_CLIENT_SECRET=dashboard-signer-dev-secret
SIGNER_OIDC_CRYPTO_PASSPHRASE=dev-change-me

# go-livepeer remote signer (hot-path profile)
# bash scripts/build-remote-signer.sh
SIGNER_DATA_DIR=../pymthouse/data
SIGNER_NETWORK=arbitrum-one-mainnet
ETH_RPC_URL=http://nyc-router.eliteencoder.net:3517
# SIGNER_ETH_ADDR=0x0074780FefF1FD0277FAD6ccdb5a29908df6051F

SIGNER_POSTGRES_DB=signer
SIGNER_POSTGRES_USER=signer
SIGNER_POSTGRES_PASSWORD=signer_dev_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
